{
  "name": "rust-validator",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "rust-validator"
  },
  "scripts": {
    "build": "cargo build",
    "typecheck": "cargo check",
