{
  "name": "rust-validator",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "rust-validator"
  },
  "scripts": {
    "build": "cargo build",
    "typecheck": "cargo check",
    "test": "cargo test && bun run test:oracle && bun run test:fuzz",
    "build:napi": "napi build --platform --release --features napi --cargo-name rust_validator",
    "build:napi:debug": "napi build --platform --features napi --cargo-name rust_validator",
    "test:napi": "cargo test --features napi",
    "test:fuzz": "bun test ./test/git-policy-fuzz.test.ts",
    "test:oracle": "cargo test --release --manifest-path fuzz/Cargo.toml --lib",
    "bench": "cargo bench --manifest-path fuzz/Cargo.toml --bench git_policy",
    "fuzz": "cargo +nightly fuzz run git_policy --no-include-main-msvc --"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2",
    "simple-git": "3.36.0"
  }
}
